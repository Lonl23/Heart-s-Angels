{
  "hosting": {
    "site": "heart-s-angels-rescuetrack",
    "public": "dist-rescuetrack",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" }
        ]
      }
    ]
  }
}
